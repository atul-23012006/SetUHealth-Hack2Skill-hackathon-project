# Copy to .env for `docker compose up`. Optional — without a key the app runs
# in its deterministic offline-mock mode (no code changes needed to go live).
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Required for a live/public deployment — see docs/DEPLOYMENT.md. Left unset,
# the backend defaults to "demo" auth: no login on any console route. It
# will warn loudly about this in its own startup logs if you forget it here.
# ---------------------------------------------------------------------------
# AUTH_MODE=token
# JWT_SECRET=              # python -c "import secrets; print(secrets.token_urlsafe(48))"
# DEMO_USER_PASSWORD=      # first-seed password only; set real ones per user afterwards (see docs/DEPLOYMENT.md)
# CORS_ORIGINS=            # JSON array of your deployed frontend's origin(s), e.g. ["https://setuhealth.example.org"]
