GEMINI_API_KEY=
# Optional: model overrides. Default is Flash-Lite class (higher free-tier
# quota than plain Flash/Pro) — override to a heavier model if you have
# billing enabled and want stronger replies over more headroom.
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Real-world data feeds (weather, World Bank, OpenStreetMap). Set false for offline demos.
# LIVE_DATA_ENABLED=true

# Push alerts when a real weather signal turns high.
# SIGNAL_POLLING_ENABLED=true
# SIGNAL_POLL_MINUTES=30
# Optional: POST each alert as JSON (Slack/Teams-compatible "text" field).
# ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Required for a live/public deployment — see docs/DEPLOYMENT.md. Left unset,
# the app runs in "demo" mode: no login, no per-route rate limiting, and any
# CORS_ORIGINS is echoed back to every caller. Fine for a local/offline demo,
# unsafe for anything reachable outside localhost.
# ---------------------------------------------------------------------------
# AUTH_MODE=token
# Sign a 32+ byte random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset, a new one is generated on every restart, which silently signs everyone out.
# JWT_SECRET=
# Only used the first time the account table is seeded — set real, distinct
# passwords afterwards with `python -m app.scripts.manage_users set-password`.
# Unset, a random one is generated and logged once (not stored anywhere else).
# DEMO_USER_PASSWORD=
# Your deployed frontend's exact origin(s), as a JSON array (no trailing
# slash) — e.g. ["https://setuhealth.example.org"]. Unset defaults to "*",
# which lets any website call this API from a browser.
# CORS_ORIGINS=
