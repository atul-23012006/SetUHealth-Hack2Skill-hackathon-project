GEMINI_API_KEY=
# Optional: model overrides. Default is Flash-Lite class (higher free-tier
# quota than plain Flash/Pro) — override to a heavier model if you have
# billing enabled and want stronger replies over more headroom.
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Real-world data feeds (weather, World Bank, OpenStreetMap). Set false for offline demos.
# LIVE_DATA_ENABLED=true

# Push alerts when a real weather signal turns high.
# SIGNAL_POLLING_ENABLED=true
# SIGNAL_POLL_MINUTES=30
# Optional: POST each alert as JSON (Slack/Teams-compatible "text" field).
# ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Required for a live/public deployment — see docs/DEPLOYMENT.md. Left unset,
# the app runs in "demo" mode: no login, no per-route rate limiting, and any
# CORS_ORIGINS is echoed back to every caller. Fine for a local/offline demo,
# unsafe for anything reachable outside localhost.
# ---------------------------------------------------------------------------
# AUTH_MODE=token
# Sign a 32+ byte random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset, a new one is generated on every restart, which silently signs everyone out.
# JWT_SECRET=
# Only used the first time the account table is seeded — set real, distinct
# passwords afterwards with `python -m app.scripts.manage_users set-password`.
# Unset, a random one is generated and logged once (not stored anywhere else).
# DEMO_USER_PASSWORD=
# Your deployed frontend's exact origin(s), as a JSON array (no trailing
# slash) — e.g. ["https://setuhealth.example.org"]. Unset defaults to "*",
# which lets any website call this API from a browser.
# CORS_ORIGINS=

# On a memory-capped host (e.g. Render's free 512Mi web service), set this to
# 0: the default spawns a handful of extra OS processes to parallelize
# forecasting/redistribution, each of which reimports the whole app and
# reloads the full dataset independently — enough to OOM a small container
# before it ever opens its port. 0 runs that work inline instead (slower per
# call, no duplicated memory). Leave unset on a normal-sized host.
# WORKER_POOL_SIZE=0

# Also set this on a CPU-capped host (Render's free tier: 0.1 CPU). With
# WORKER_POOL_SIZE=0, the default's eager national-forecast warmup at startup
# (~1,866 fits, one at a time on 0.1 CPU) can take long enough to blow past
# the platform's own boot window. false defers it to the first request that
# actually needs it (results are cached after, same as eager).
# EAGER_WARMUP=false

# AUTH_MODE=token only: scrypt's memory cost as a power of 2 (real cost is
# ~128 * 2**this * 8 bytes). 14 (the default, ~16 MiB) is reasonable on a
# normal host. On a 512Mi one, that allocation on top of an already-tight
# baseline (pandas/numpy/scipy/statsmodels + the full dataset) has been
# enough to OOM-kill the whole process on the very first login. Lower to 12
# (~4 MiB) there — still a real, deliberately slow hash, just lighter.
# AUTH_SCRYPT_N_LOG2=12

# Trims baseline memory further on a tight host: both poll/cache real-world
# data (weather etc.) that isn't essential to a demo.
# LIVE_DATA_ENABLED=false
# SIGNAL_POLLING_ENABLED=false
